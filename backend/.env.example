# Copiar como .env.local. run.sh y run.ps1 lo cargan automáticamente; no subir .env.local a Git.
SPRING_PROFILES_ACTIVE=dev
IER_DB_URL=jdbc:postgresql://localhost:5432/ier_dev_v2
# Cambia el usuario/contraseña para que coincidan con tu PostgreSQL local.
IER_DB_USERNAME=postgres
IER_DB_PASSWORD='CAMBIAR_POR_PASSWORD_DE_TU_POSTGRES'
APP_FRONTEND_URL=http://localhost:4200
APP_CORS_ORIGINS=http://localhost:4200
# Opcional: el perfil dev genera un JWT aleatorio si JWT_SECRET no se define.
# Opcional SMTP; usa una contraseña de aplicación nueva, nunca la contraseña normal.
# SPRING_MAIL_USERNAME=correo-remitente@gmail.com
# SPRING_MAIL_PASSWORD='CONTRASENA_DE_APLICACION'
# APP_MAIL_CONTACTO=correo-que-recibe-contactos@example.org
# Opcional Brevo por HTTPS; tiene prioridad sobre SMTP.
# BREVO_API_KEY=tu-api-key
# APP_MAIL_FROM=correo-verificado@example.org
# APP_MAIL_FROM_NAME=IER
# Opcional para crear administrador en base vacía (mínimo 12 caracteres).
# APP_BOOTSTRAP_ADMIN_USERNAME=admin
# APP_BOOTSTRAP_ADMIN_PASSWORD='CAMBIAR_POR_UNA_CONTRASENA_SEGURA'
