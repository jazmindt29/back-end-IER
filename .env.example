# Copiar como .env y completar antes de: docker compose up -d --build
# No subir .env a Git.

# --- Base de datos (obligatorio) ---
POSTGRES_DB=ier
POSTGRES_USER=ier
# openssl rand -base64 48
POSTGRES_PASSWORD=

# --- Aplicación (obligatorio) ---
# Mínimo 32 bytes. Al cambiarlo se invalidan las sesiones activas.
JWT_SECRET=

# --- Puertos publicados ---
WEB_PORT=8080
DB_PORT=5433

# --- Perfil de Spring ---
# "prod" para operación normal. Usar "bootstrap" solo para crear el primer
# administrador en una base vacía y después volver a "prod".
IER_PROFILE=prod

# --- URL pública del frontend (enlaces de invitación y CORS) ---
APP_FRONTEND_URL=http://localhost:8080
APP_CORS_ORIGINS=http://localhost:8080

# --- Administrador inicial (solo con IER_PROFILE=bootstrap) ---
# APP_BOOTSTRAP_ADMIN_USERNAME=admin
# APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Correo (opcional) ---
APP_MAIL_CONTACTO=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
